// Cloudflare Worker that serves sherlockreports.com: the static site in sherlock-research/
// plus src/worker.js (password gate, security headers, Payhip webhook, lead and resend APIs).
//
//   npx wrangler deploy       deploy (Workers Builds runs this on pushes to master)
//   npx wrangler dev          local preview with the Worker in front of the site
//
// Secrets are set in Cloudflare, never here: PREVIEW_PASSWORD (unset = site is public),
// PAYHIP_API_KEY, TURNSTILE_SECRET_KEY.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sherlockresearch",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "directory": "./sherlock-research",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "FULFILLMENTS", "id": "bce1d900461642a292124c8cc432bb88" }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@sherlockreports.com", "support@sherlockreports.com"]
    }
  ]
}

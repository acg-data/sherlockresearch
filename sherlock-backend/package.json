{
  "name": "sherlock-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sherlock Research report generation backend on Cloudflare",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "migrate:local": "wrangler d1 migrations apply sherlock-research --local",
    "migrate:remote": "wrangler d1 migrations apply sherlock-research --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^0.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.95.0"
  }
}

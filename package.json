{
  "name": "sherlock-research-site",
  "private": true,
  "description": "Sherlock Research marketing site: static pages in sherlock-research/ served by a Cloudflare Worker (src/worker.js).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:browser": "node scripts/check.mjs --browser",
    "sample-pdf": "node scripts/sample-pdf.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "npx wrangler@4 dev",
    "deploy": "npx wrangler@4 deploy"
  }
}

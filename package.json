{
  "name": "sherlockresearch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract-insights": "node sherlock-research/scripts/extract-insights.mjs",
    "generate": "node sherlock-research/scripts/generate-site.mjs",
    "audit": "node sherlock-research/scripts/audit-site.mjs",
    "prepare-assets": "node scripts/prepare-assets.mjs",
